{
  "Uuid": "f35abb97-0179-4e01-a470-492dc3fd81ad",
  "IsCustomNode": false,
  "Description": "Footprint line -> polyline -> feature line -> daylight grading -> TIN surface. All prompts on the Civil 3D command line. Run in MANUAL mode.",
  "Name": "GradingFromLayer",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# ============================================================================\n#  GRADING FROM LAYER  \u2014  Dynamo for Civil 3D  (Python node, CPython3 engine)\n# ============================================================================\n#  Workflow (all prompts happen on the Civil 3D command line):\n#    1. Pick a LINE  -> its layer becomes the footprint layer\n#       (all LINEs on that layer are chained end-to-end into one polyline;\n#        if you pick a POLYLINE instead, it is used directly)\n#    2. A 2D polyline footprint is created\n#    3. You select the target TIN surface\n#    4. You enter the design elevation of the pad / footprint\n#    5. A feature line is created from the polyline (in site \"Grading Site\")\n#    6. You enter cut slope, fill slope (H : 1V), sample step, max projection\n#       distance, and pick a point on the side you want to grade towards\n#    7. The daylight line is computed by projecting from the feature line at\n#       your slopes until it intersects the target surface\n#    8. A new TIN surface is created from footprint + daylight + slope lines\n#\n#  NOTE: Autodesk does NOT expose grading-object creation in any public API,\n#  so this script reproduces the grading geometrically (daylight projection).\n#  The result is a daylight 3D-polyline, slope projection lines, and a TIN\n#  surface \u2014 the same end product as Grading Creation Tools + auto surface.\n#\n#  Run Dynamo in MANUAL run mode. After clicking Run, switch to the Civil 3D\n#  window and answer the command-line prompts.\n# ============================================================================\n\nimport clr\nimport math\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, BlockTable, BlockTableRecord, Line, Polyline, Polyline3d,\n    Poly3dType, ObjectIdCollection, LayerTableRecord)\nfrom Autodesk.AutoCAD.EditorInput import (\n    PromptEntityOptions, PromptDoubleOptions, PromptPointOptions,\n    PromptStringOptions, PromptStatus)\nfrom Autodesk.AutoCAD.Geometry import (\n    Point2d, Point3d, Point3dCollection)\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import FeatureLine, TinSurface, Site\n\ntry:\n    from Autodesk.Civil import SurfaceBoundaryType\n    HAS_BND = True\nexcept Exception:\n    HAS_BND = False\n\nTOL = 0.01          # connection tolerance for chaining lines (drawing units)\nSITE_NAME = \"Grading Site\"\nLAY_FOOT = \"C-GRAD-FOOTPRINT\"\nLAY_DAY = \"C-GRAD-DAYLIGHT\"\nLAY_SLOPE = \"C-GRAD-SLOPES\"\n\nadoc = Application.DocumentManager.MdiActiveDocument\ned = adoc.Editor\ndb = adoc.Database\ncivdoc = CivilApplication.ActiveDocument\n\nlog = []\n\n\n# ----------------------------------------------------------- prompt helpers\ndef get_double(msg, default, allow_zero=False):\n    o = PromptDoubleOptions(msg)\n    o.DefaultValue = default\n    o.UseDefaultValue = True\n    o.AllowNegative = False\n    o.AllowZero = allow_zero\n    r = ed.GetDouble(o)\n    return r.Value if r.Status == PromptStatus.OK else None\n\n\ndef get_string(msg, default):\n    o = PromptStringOptions(msg)\n    o.DefaultValue = default\n    o.UseDefaultValue = True\n    o.AllowSpaces = False\n    r = ed.GetString(o)\n    if r.Status != PromptStatus.OK:\n        return None\n    return r.StringResult if r.StringResult else default\n\n\n# ----------------------------------------------------------- geometry helpers\ndef close_pts(a, b, tol=TOL):\n    return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2 <= tol * tol\n\n\ndef chain_lines(segs, start_idx):\n    \"\"\"Chain (start,end) segments into one ordered point list.\"\"\"\n    chain = [segs[start_idx][0], segs[start_idx][1]]\n    used = set([start_idx])\n    extended = True\n    while extended:\n        extended = False\n        for j in range(len(segs)):\n            if j in used:\n                continue\n            a, b = segs[j]\n            if close_pts(chain[-1], a):\n                chain.append(b); used.add(j); extended = True\n            elif close_pts(chain[-1], b):\n                chain.append(a); used.add(j); extended = True\n            elif close_pts(chain[0], a):\n                chain.insert(0, b); used.add(j); extended = True\n            elif close_pts(chain[0], b):\n                chain.insert(0, a); used.add(j); extended = True\n    closed = len(chain) > 3 and close_pts(chain[0], chain[-1])\n    if closed:\n        chain = chain[:-1]\n    return chain, closed, len(used)\n\n\ndef cum_lengths(pts, closed):\n    n = len(pts)\n    cl = [0.0]\n    m = n if closed else n - 1\n    for i in range(m):\n        x1, y1 = pts[i]\n        x2, y2 = pts[(i + 1) % n]\n        cl.append(cl[-1] + math.hypot(x2 - x1, y2 - y1))\n    return cl  # cl[-1] == total length\n\n\ndef point_tangent_at(pts, closed, cl, d):\n    \"\"\"XY point + unit tangent at distance d along the footprint.\"\"\"\n    n = len(pts)\n    total = cl[-1]\n    d = max(0.0, min(d, total - 1e-9))\n    for i in range(len(cl) - 1):\n        if cl[i] <= d <= cl[i + 1]:\n            x1, y1 = pts[i]\n            x2, y2 = pts[(i + 1) % n]\n            seg = cl[i + 1] - cl[i]\n            t = 0.0 if seg == 0 else (d - cl[i]) / seg\n            dx, dy = x2 - x1, y2 - y1\n            ln = math.hypot(dx, dy)\n            if ln == 0:\n                continue\n            return (x1 + t * dx, y1 + t * dy, dx / ln, dy / ln)\n    x1, y1 = pts[0]\n    x2, y2 = pts[1 % n]\n    dx, dy = x2 - x1, y2 - y1\n    ln = math.hypot(dx, dy) or 1.0\n    return (x1, y1, dx / ln, dy / ln)\n\n\ndef side_sign(pts, closed, px, py):\n    \"\"\"+1 / -1 depending on which side of the footprint the pick point lies.\"\"\"\n    n = len(pts)\n    m = n if closed else n - 1\n    best = None\n    for i in range(m):\n        x1, y1 = pts[i]\n        x2, y2 = pts[(i + 1) % n]\n        dx, dy = x2 - x1, y2 - y1\n        L2 = dx * dx + dy * dy\n        if L2 == 0:\n            continue\n        t = max(0.0, min(1.0, ((px - x1) * dx + (py - y1) * dy) / L2))\n        cx, cy = x1 + t * dx, y1 + t * dy\n        d2 = (px - cx) ** 2 + (py - cy) ** 2\n        if best is None or d2 < best[0]:\n            best = (d2, dx * (py - cy) - dy * (px - cx))\n    return 1 if (best and best[1] > 0) else -1\n\n\ndef ensure_layer(t, name):\n    lt = t.GetObject(db.LayerTableId, OpenMode.ForRead)\n    if not lt.Has(name):\n        lt.UpgradeOpen()\n        ltr = LayerTableRecord()\n        ltr.Name = name\n        lt.Add(ltr)\n        t.AddNewlyCreatedDBObject(ltr, True)\n    return name\n\n\ndef unique_surface_name(t, base):\n    names = set()\n    try:\n        for sid in civdoc.GetSurfaceIds():\n            s = t.GetObject(sid, OpenMode.ForRead)\n            names.add(s.Name)\n    except Exception:\n        pass\n    if base not in names:\n        return base\n    i = 1\n    while (\"%s_%d\" % (base, i)) in names:\n        i += 1\n    return \"%s_%d\" % (base, i)\n\n\n# ============================================================ PHASE 1: INPUT\nresult_msg = \"\"\ntry:\n    # ---- 1. pick footprint line --------------------------------------------\n    peo = PromptEntityOptions(\"\\nSelect a LINE or POLYLINE on the footprint layer: \")\n    peo.SetRejectMessage(\"\\nMust be a Line or Polyline.\")\n    peo.AddAllowedClass(clr.GetClrType(Line), False)\n    peo.AddAllowedClass(clr.GetClrType(Polyline), False)\n    sel = ed.GetEntity(peo)\n    if sel.Status != PromptStatus.OK:\n        raise Exception(\"Cancelled at footprint selection.\")\n\n    pts = []\n    closed = False\n    layer_name = \"\"\n    n_chained = 1\n\n    t = db.TransactionManager.StartTransaction()\n    try:\n        ent = t.GetObject(sel.ObjectId, OpenMode.ForRead)\n        layer_name = ent.Layer\n        if isinstance(ent, Polyline):\n            for i in range(ent.NumberOfVertices):\n                p = ent.GetPoint2dAt(i)\n                pts.append((p.X, p.Y))\n            closed = bool(ent.Closed)\n        else:\n            # collect ALL lines on that layer and chain them\n            segs = []\n            picked_idx = 0\n            bt = t.GetObject(db.BlockTableId, OpenMode.ForRead)\n            ms = t.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\n            for oid in ms:\n                try:\n                    obj = t.GetObject(oid, OpenMode.ForRead)\n                except Exception:\n                    continue\n                if isinstance(obj, Line) and obj.Layer == layer_name:\n                    if oid == sel.ObjectId:\n                        picked_idx = len(segs)\n                    segs.append(((obj.StartPoint.X, obj.StartPoint.Y),\n                                 (obj.EndPoint.X, obj.EndPoint.Y)))\n            pts, closed, n_chained = chain_lines(segs, picked_idx)\n        t.Commit()\n    finally:\n        t.Dispose()\n\n    if len(pts) < 2:\n        raise Exception(\"Could not build a footprint from layer '%s'.\" % layer_name)\n    log.append(\"Footprint: %d vertices (%s), %d line(s) chained, layer '%s'.\"\n               % (len(pts), \"closed\" if closed else \"open\", n_chained, layer_name))\n\n    # ---- 2. select target surface ------------------------------------------\n    pso = PromptEntityOptions(\"\\nSelect target TIN surface: \")\n    pso.SetRejectMessage(\"\\nMust be a TIN surface.\")\n    pso.AddAllowedClass(clr.GetClrType(TinSurface), False)\n    ssel = ed.GetEntity(pso)\n    if ssel.Status != PromptStatus.OK:\n        raise Exception(\"Cancelled at surface selection.\")\n    target_surf_id = ssel.ObjectId\n\n    # default pad elevation = surface elevation at first footprint vertex\n    def_elev = 0.0\n    t = db.TransactionManager.StartTransaction()\n    try:\n        tin = t.GetObject(target_surf_id, OpenMode.ForRead)\n        try:\n            def_elev = round(tin.FindElevationAtXY(pts[0][0], pts[0][1]), 2)\n        except Exception:\n            def_elev = 0.0\n        t.Commit()\n    finally:\n        t.Dispose()\n\n    # ---- 3. grading parameters ---------------------------------------------\n    elev = get_double(\"\\nDesign elevation of feature line <%s>: \" % def_elev,\n                      def_elev, allow_zero=True)\n    if elev is None:\n        raise Exception(\"Cancelled at elevation.\")\n\n    cut_slope = get_double(\"\\nCUT slope, H per 1V (e.g. 2 = 2:1) <2.0>: \", 2.0)\n    if cut_slope is None:\n        raise Exception(\"Cancelled at cut slope.\")\n\n    fill_slope = get_double(\"\\nFILL slope, H per 1V (e.g. 3 = 3:1) <3.0>: \", 3.0)\n    if fill_slope is None:\n        raise Exception(\"Cancelled at fill slope.\")\n\n    step = get_double(\"\\nSample step along footprint <2.0>: \", 2.0)\n    if step is None:\n        raise Exception(\"Cancelled at step.\")\n\n    max_d = get_double(\"\\nMaximum projection distance <100.0>: \", 100.0)\n    if max_d is None:\n        raise Exception(\"Cancelled at max distance.\")\n\n    surf_name = get_string(\"\\nName for new grading surface <GRADING-SURF>: \",\n                           \"GRADING-SURF\")\n    if surf_name is None:\n        raise Exception(\"Cancelled at surface name.\")\n\n    ppo = PromptPointOptions(\"\\nPick a point on the side to grade towards (outside): \")\n    pres = ed.GetPoint(ppo)\n    if pres.Status != PromptStatus.OK:\n        raise Exception(\"Cancelled at side pick.\")\n    sgn = side_sign(pts, closed, pres.Value.X, pres.Value.Y)\n\n    # ========================================================= PHASE 2: BUILD\n    cl = cum_lengths(pts, closed)\n    total_len = cl[-1]\n    if total_len <= 0:\n        raise Exception(\"Zero-length footprint.\")\n\n    # sample distances: regular step + just before/after each vertex (corners)\n    dset = set()\n    d = 0.0\n    while d < total_len:\n        dset.add(round(d, 4))\n        d += step\n    if not closed:\n        dset.add(round(total_len - 1e-6, 4))\n    eps = min(0.05, step / 10.0)\n    for cd in cl[1:-1]:\n        dset.add(round(max(0.0, cd - eps), 4))\n        dset.add(round(min(total_len - 1e-6, cd + eps), 4))\n    dlist = sorted(dset)\n\n    dlock = adoc.LockDocument()\n    try:\n        t = db.TransactionManager.StartTransaction()\n        try:\n            ensure_layer(t, LAY_FOOT)\n            ensure_layer(t, LAY_DAY)\n            ensure_layer(t, LAY_SLOPE)\n\n            bt = t.GetObject(db.BlockTableId, OpenMode.ForRead)\n            ms = t.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForWrite)\n\n            # ---- polyline from the chained lines ----\n            pl = Polyline()\n            for i, (x, y) in enumerate(pts):\n                pl.AddVertexAt(i, Point2d(x, y), 0.0, 0.0, 0.0)\n            pl.Closed = closed\n            pl.Elevation = elev\n            pl.Layer = LAY_FOOT\n            pl_id = ms.AppendEntity(pl)\n            t.AddNewlyCreatedDBObject(pl, True)\n            log.append(\"Polyline created at elevation %.3f.\" % elev)\n\n            # ---- site (find or create) ----\n            site_id = None\n            try:\n                for sid in civdoc.GetSiteIds():\n                    s = t.GetObject(sid, OpenMode.ForRead)\n                    if s.Name == SITE_NAME:\n                        site_id = sid\n                        break\n            except Exception:\n                pass\n            if site_id is None:\n                try:\n                    site_id = Site.Create(civdoc, SITE_NAME)\n                    log.append(\"Site '%s' created.\" % SITE_NAME)\n                except Exception:\n                    site_id = None\n\n            # ---- feature line ----\n            fl_name = \"FL_\" + surf_name\n            try:\n                if site_id is not None:\n                    fl_id = FeatureLine.Create(fl_name, pl_id, site_id)\n                else:\n                    fl_id = FeatureLine.Create(fl_name, pl_id)\n                log.append(\"Feature line '%s' created.\" % fl_name)\n            except Exception as ex:\n                raise Exception(\"Feature line creation failed: %s\" % ex)\n\n            # ---- daylight computation ----\n            tin = t.GetObject(target_surf_id, OpenMode.ForRead)\n\n            def surf_z(x, y):\n                try:\n                    return tin.FindElevationAtXY(x, y)\n                except Exception:\n                    return None\n\n            day_pts = []          # daylight points (x, y, z)\n            proj_pairs = []       # (foot point 3d, daylight point 3d)\n            skipped = 0\n            march = max(0.25, min(1.0, max_d / 200.0))\n\n            for d in dlist:\n                x0, y0, tx, ty = point_tangent_at(pts, closed, cl, d)\n                nx, ny = -ty * sgn, tx * sgn\n                s0 = surf_z(x0, y0)\n                if s0 is None:\n                    skipped += 1\n                    continue\n                if elev >= s0:\n                    slope, zdir = fill_slope, -1.0   # fill: project down\n                else:\n                    slope, zdir = cut_slope, 1.0     # cut: project up\n\n                def fval(dd):\n                    sz = surf_z(x0 + nx * dd, y0 + ny * dd)\n                    if sz is None:\n                        return None\n                    return (elev + zdir * dd / slope) - sz\n\n                f0 = elev - s0\n                lo, flo = 0.0, f0\n                hit = None\n                dd = march\n                while dd <= max_d:\n                    fd = fval(dd)\n                    if fd is None:\n                        break                      # left surface extents\n                    if (flo <= 0 <= fd) or (fd <= 0 <= flo):\n                        # bisection refine\n                        a, b, fa = lo, dd, flo\n                        for _ in range(40):\n                            m = 0.5 * (a + b)\n                            fm = fval(m)\n                            if fm is None:\n                                break\n                            if (fa <= 0 <= fm) or (fm <= 0 <= fa):\n                                b = m\n                            else:\n                                a, fa = m, fm\n                        hit = 0.5 * (a + b)\n                        break\n                    lo, flo = dd, fd\n                    dd += march\n\n                if hit is None or hit < 1e-6:\n                    skipped += 1\n                    continue\n                zx = elev + zdir * hit / slope\n                fx, fy = x0 + nx * hit, y0 + ny * hit\n                day_pts.append((fx, fy, zx))\n                proj_pairs.append(((x0, y0, elev), (fx, fy, zx)))\n\n            if len(day_pts) < 2:\n                raise Exception(\"Daylight not found (%d samples skipped). \"\n                                \"Check side pick, slopes, elevation and max \"\n                                \"distance vs. surface extents.\" % skipped)\n            log.append(\"Daylight computed: %d points (%d samples skipped).\"\n                       % (len(day_pts), skipped))\n\n            # ---- daylight 3D polyline ----\n            p3c = Point3dCollection()\n            for (x, y, z) in day_pts:\n                p3c.Add(Point3d(x, y, z))\n            day_pl = Polyline3d(Poly3dType.SimplePoly, p3c, closed)\n            day_pl.Layer = LAY_DAY\n            day_id = ms.AppendEntity(day_pl)\n            t.AddNewlyCreatedDBObject(day_pl, True)\n\n            # ---- slope projection lines (visual + breaklines) ----\n            slope_ids = ObjectIdCollection()\n            for (a, b) in proj_pairs:\n                ln = Line(Point3d(a[0], a[1], a[2]), Point3d(b[0], b[1], b[2]))\n                ln.Layer = LAY_SLOPE\n                lid = ms.AppendEntity(ln)\n                t.AddNewlyCreatedDBObject(ln, True)\n                slope_ids.Add(lid)\n\n            # ---- new TIN surface ----\n            new_name = unique_surface_name(t, surf_name)\n            new_surf_id = TinSurface.Create(db, new_name)\n            new_tin = t.GetObject(new_surf_id, OpenMode.ForWrite)\n\n            brk = ObjectIdCollection()\n            brk.Add(fl_id)\n            brk.Add(day_id)\n            try:\n                new_tin.BreaklinesDefinition.AddStandardBreaklines(\n                    brk, 1.0, 0.0, 0.0, 0.0)\n                if slope_ids.Count <= 800:\n                    new_tin.BreaklinesDefinition.AddStandardBreaklines(\n                        slope_ids, 1.0, 0.0, 0.0, 0.0)\n            except Exception:\n                new_tin.BreaklinesDefinition.AddStandardBreaklines(\n                    brk, 1.0, 100.0, 0.0, 0.0)\n\n            if closed and HAS_BND:\n                try:\n                    bnd = ObjectIdCollection()\n                    bnd.Add(day_id)\n                    new_tin.BoundariesDefinition.AddBoundaries(\n                        bnd, 1.0, SurfaceBoundaryType.Outer, True)\n                except Exception:\n                    log.append(\"Note: outer boundary could not be added.\")\n\n            try:\n                new_tin.Rebuild()\n            except Exception:\n                pass\n\n            log.append(\"Surface '%s' created.\" % new_name)\n            t.Commit()\n        except Exception:\n            t.Abort()\n            raise\n        finally:\n            t.Dispose()\n    finally:\n        dlock.Dispose()\n\n    ed.Regen()\n    result_msg = \"DONE\\n\" + \"\\n\".join(log)\n    ed.WriteMessage(\"\\n\" + result_msg + \"\\n\")\n\nexcept Exception as e:\n    result_msg = \"FAILED: %s\\n%s\\n--- log ---\\n%s\" % (\n        e, traceback.format_exc(), \"\\n\".join(log))\n    try:\n        ed.WriteMessage(\"\\n\" + str(e) + \"\\n\")\n    except Exception:\n        pass\n\nOUT = result_msg\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
