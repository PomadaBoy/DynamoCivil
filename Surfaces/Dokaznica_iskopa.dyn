    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# -*- coding: utf-8 -*-\n\"\"\"\nDOKAZNICA KOLIČINA ISKOPA  -  Civil 3D 2022 / Dynamo (Python Script node)\n\nŠta radi:\n  1. Traži od korisnika da izabere osovinu (alignment) u crtežu\n     (ili uzima ime osovine sa ulaza IN[0]), otvara dijalog (stil prikaza,\n     set traka, lista materijala - postojeća ili nova, boja materijala),\n     pa traži tačku umetanja za nove prikaze poprečnih preseka.\n  2. Čita grupu poprečnih preseka (sample line group) i listu materijala\n     (QTO material list) te osovine.\n  3. Za svaki presek očitava površinu materijala i računa zapreminu\n     metodom srednjih površina:  V = (A1 + A2) / 2 * L\n  4. Pravi A3 lejaute: 2 poprečna profila po listu (ili 1 ako je profil\n     prevelik), uz svaki profil tabelu količina i ispisan proračun.\n  5. Na kraju pravi rekapitulaciju (sve profile) + kontrolu sa\n     zapreminskom površinom (TIN volume surface), ako postoji.\n\nPokretanje: Dynamo -> Python Script node (CPython3 ili IronPython2),\nnalepiti ceo ovaj fajl. IN[0] = ime osovine (prazno = izbor mišem).\nIli otvoriti priloženi Dokaznica_iskopa.dyn u Dynamo Player-u.\n\"\"\"\nimport math\nimport datetime\n\n# =====================================================================\n# PODEŠAVANJA\n# =====================================================================\nCFG = {\n    \"PROJEKAT\": u\"Most Vojislavljevića\",\n    \"NASLOV\": u\"Dokaznica količina iskopa – leva strana\",\n    \"BROJ_CRTEZA\": u\"MVO-GT-DO-ZR-01\",\n    \"RAZMERA\": 0,                  # 0 = automatski; npr. 200 => 1:200 za sve profile\n    \"MAX_RAZMERA_2_PO_LISTU\": 250, # ako auto razmera za 2 profila/listu prelazi ovo -> 1 profil/listu\n    \"PREFIKS_LEJAUTA\": u\"Dok_\",\n    \"OBRISI_STARE_LEJAUTE\": True,  # briše lejaute koji počinju prefiksom (ponovno pokretanje)\n    \"KORISTI_POSTOJECE_PRIKAZE\": False, # True: koristi postojeći section view; False: pravi nove na izabranoj tački\n    \"PRIKAZA_U_REDU\": 4,           # broj novih prikaza preseka u jednom redu (model)\n    \"RAZMAK_PRIKAZA\": 30.0,        # razmak između novih prikaza preseka [m]\n    \"GRUPA_PRESEKA\": u\"\",          # ime sample line grupe; \"\" = prva sa listom materijala\n    \"STIL_PRIKAZA_PRESEKA\": u\"Putevi-SRB\",  # podrazumevani izbor u dijalogu\n    \"SET_TRAKA\": u\"Milos Band Set\",  # podrazumevani set traka u dijalogu\n    \"BOJA_MATERIJALA\": (223, 255, 128),  # početna boja u dijalogu (RGB)\n    \"BLOK_ZAGLAVLJA\": u\"\",         # ime bloka A3 okvira (0,0 = donji levi ugao papira); \"\" = crta se jednostavan okvir\n    \"UREDJAJ\": u\"DWG To PDF.pc3\",\n    \"FORMAT_PAPIRA\": u\"ISO_full_bleed_A3_(420.00_x_297.00_MM)\",\n    \"DECIMALNI_ZNAK\": u\".\",\n    \"ZAOKRUZI_ZA_DOKAZ\": True,     # True: računa sa prikazanim (zaokruženim) A i L -> proračun se ručno proverava\n                                   # False: računa nezaokruženo kao Civil 3D tabele (razlika par stotih m³)\n    \"PROREDJIVANJE_TRAKA\": 1.0,    # weeding traka [m]: min. razmak oznaka (sprečava preklapanje brojeva); 0 = isključeno\n    \"MARGINA_PRIKAZA\": 2.0,        # dodatna margina oko prikaza preseka u viewportu [m modela]\n    \"KONTROLNA_POVRSINA\": u\"\",     # ime zapreminske površine za kontrolu; \"\" = sve zapreminske površine\n}\n\n# =====================================================================\n# GEOMETRIJA LISTA (mm, A3 položeno 420 x 297)\n# =====================================================================\nSTD_SCALES = [50, 100, 200, 250, 500, 1000, 2000, 5000]\nFRAME = (20.0, 10.0, 410.0, 287.0)\nTB = (240.0, 10.0, 410.0, 50.0)          # sastavnica\nNOTE = (20.0, 10.0, 240.0, 50.0)         # napomena o metodi\nSLOT_TOP = (20.0, 168.5, 410.0, 287.0)\nSLOT_BOT = (20.0, 50.0, 410.0, 168.5)\nSLOT_FULL = (20.0, 50.0, 410.0, 287.0)\nPANEL_W = 110.0\nVP_MARGIN = 2.0\nFIT_FACTOR = 1.04\nROW_H = 6.0\nSUM_TOP = 276.0\nSUM_BOTTOM = 55.0\nSUM_HEADER_H = 10.0\nSUM_X = 25.0\nSUM_COLS = [22.0, 28.0, 24.0, 26.0, 30.0, 28.0, 32.0]\nSEC_COLS = [26.0, 24.0, 26.0, 30.0]\n\nC_TITLE = 2    # žuta\nC_HEADER = 30  # narandžasta\n\n\n# =====================================================================\n# ČISTA LOGIKA (bez Civil 3D API - može se testirati van AutoCAD-a)\n# =====================================================================\ndef fmt(v, d=2):\n    s = (\"{0:.\" + str(d) + \"f}\").format(v)\n    return s.replace(\".\", CFG[\"DECIMALNI_ZNAK\"])\n\n\ndef fmt_sta(s):\n    km = int(s // 1000.0)\n    m = s - km * 1000.0\n    return u\"{0}+{1}\".format(km, fmt(m, 3).zfill(7))\n\n\ndef polygon_area(pts):\n    n = len(pts)\n    if n < 3:\n        return 0.0\n    a = 0.0\n    for i in range(n):\n        x1, y1 = pts[i]\n        x2, y2 = pts[(i + 1) % n]\n        a += x1 * y2 - x2 * y1\n    return abs(a) / 2.0\n\n\ndef compute_quantities(sections, mats):\n    \"\"\"sections: lista dict {name, sta, areas:[A po materijalu]} sortirana po stacionaži.\n    Računa sa zaokruženim vrednostima (A 0.01, St 0.001, V 0.01) da bi proračun\n    na listu mogao ručno da se proveri do poslednje cifre.\"\"\"\n    rnd = CFG[\"ZAOKRUZI_ZA_DOKAZ\"]\n    prev = None\n    cum = [0.0] * len(mats)\n    for sec in sections:\n        sec[\"sta_r\"] = round(sec[\"sta\"], 3) if rnd else sec[\"sta\"]\n        sec[\"A\"] = [round(a, 2) for a in sec[\"areas\"]] if rnd else list(sec[\"areas\"])\n        sec[\"L\"] = None if prev is None else (\n            round(sec[\"sta_r\"] - prev[\"sta_r\"], 3) if rnd else sec[\"sta_r\"] - prev[\"sta_r\"])\n        sec[\"avg\"], sec[\"V\"], sec[\"cum_prev\"] = [], [], list(cum)\n        for i in range(len(mats)):\n            if prev is None:\n                avg, v = None, 0.0\n            else:\n                avg = (prev[\"A\"][i] + sec[\"A\"][i]) / 2.0\n                v = round(avg * sec[\"L\"], 2) if rnd else avg * sec[\"L\"]\n            cum[i] = round(cum[i] + v, 2) if rnd else cum[i] + v\n            sec[\"avg\"].append(avg)\n            sec[\"V\"].append(v)\n        sec[\"cum\"] = list(cum)\n        sec[\"prev\"] = prev\n        prev = sec\n    return cum\n\n\ndef vp_box(slot):\n    x0, y0, x1, y1 = slot\n    return (x0 + VP_MARGIN, y0 + VP_MARGIN, x1 - PANEL_W - VP_MARGIN, y1 - VP_MARGIN)\n\n\ndef vp_fit(box, sec):\n    \"\"\"Viewport tačno oko prikaza preseka (da se ne vide susedni prikazi u modelu).\"\"\"\n    k = 1000.0 / sec[\"scale\"] * FIT_FACTOR\n    w = min(box[2] - box[0], sec[\"w\"] * k)\n    h = min(box[3] - box[1], sec[\"h\"] * k)\n    cx, cy = (box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0\n    return (cx - w / 2.0, cy - h / 2.0, cx + w / 2.0, cy + h / 2.0)\n\n\ndef panel_box(slot):\n    return (slot[2] - PANEL_W, slot[1], slot[2], slot[3])\n\n\ndef fits(sec, slot, s):\n    b = vp_box(slot)\n    return (sec[\"w\"] * 1000.0 / s * FIT_FACTOR <= b[2] - b[0] and\n            sec[\"h\"] * 1000.0 / s * FIT_FACTOR <= b[3] - b[1])\n\n\ndef min_scale(sec, slot):\n    for s in STD_SCALES:\n        if fits(sec, slot, s):\n            return s\n    return STD_SCALES[-1]\n\n\ndef plan_sheets(sections):\n    \"\"\"Vraća (razmera, listovi). List = lista (presek, slot).\"\"\"\n    S = CFG[\"RAZMERA\"]\n    if not S:\n        S = max(min_scale(sec, SLOT_TOP) for sec in sections)\n        if S > CFG[\"MAX_RAZMERA_2_PO_LISTU\"]:\n            S = max(min_scale(sec, SLOT_FULL) for sec in sections)\n    sheets, cur = [], None\n    for sec in sections:\n        if fits(sec, SLOT_TOP, S):\n            sec[\"scale\"] = S\n            if cur is not None and len(cur) == 1 and cur[0][1] == SLOT_TOP:\n                cur.append((sec, SLOT_BOT))\n            else:\n                cur = [(sec, SLOT_TOP)]\n                sheets.append(cur)\n        else:\n            sec[\"scale\"] = S if fits(sec, SLOT_FULL, S) else min_scale(sec, SLOT_FULL)\n            cur = [(sec, SLOT_FULL)]\n            sheets.append(cur)\n    return S, sheets\n\n\ndef plan_summary(sections, mats):\n    rows = []\n    for i, m in enumerate(mats):\n        if len(mats) > 1:\n            rows.append((\"mat\", i))\n        for sec in sections:\n            rows.append((\"row\", i, sec))\n        rows.append((\"total\", i))\n    if len(mats) > 1:\n        rows.append((\"grand\",))\n    per_page = int((SUM_TOP - SUM_HEADER_H - SUM_BOTTOM) / ROW_H)\n    return [rows[i:i + per_page] for i in range(0, len(rows), per_page)] or [[]]\n\n\n# ---------------------------------------------------------------------\n# Crtanje (preko \"canvas\" interfejsa: Civil 3D ili pregled u matplotlib-u)\n# ---------------------------------------------------------------------\ndef draw_table(cv, x, ytop, cols, rows, heights, colors=None):\n    \"\"\"rows: lista redova; red = lista tekstova (len == len(cols)) ili 1 tekst (spojeno).\"\"\"\n    W = sum(cols)\n    y = ytop\n    for r, row in enumerate(rows):\n        h = heights[r]\n        col = colors[r] if colors else None\n        cv.line(x, y - h, x + W, y - h, \"DOK-TABELA\")\n        if len(row) == 1:\n            cv.text(x + W / 2.0, y - h / 2.0, row[0], 2.5, \"MC\", layer=\"DOK-TEKST\", color=col)\n        else:\n            cx = x\n            for c, t in enumerate(row):\n                if c > 0:\n                    cv.line(cx, y, cx, y - h, \"DOK-TABELA\")\n                cv.text(cx + cols[c] / 2.0, y - h / 2.0, t, 2.2, \"MC\", layer=\"DOK-TEKST\", color=col)\n                cx += cols[c]\n        y -= h\n    cv.rect(x, y, x + W, ytop, \"DOK-TABELA\")\n    return y\n\n\ndef draw_frame(cv, no, total, content, scale_txt, meta):\n    if CFG[\"BLOK_ZAGLAVLJA\"] and cv.insert_block(CFG[\"BLOK_ZAGLAVLJA\"]):\n        cv.text(FRAME[2] - 2, FRAME[3] - 2, u\"List {0}/{1}   R {2}\".format(no, total, scale_txt),\n                2.5, \"TR\", layer=\"DOK-TEKST\")\n    else:\n        cv.rect(FRAME[0], FRAME[1], FRAME[2], FRAME[3], \"DOK-OKVIR\")\n        cv.rect(TB[0], TB[1], TB[2], TB[3], \"DOK-OKVIR\")\n        labels = [u\"Projekat\", u\"Crtež\", u\"Br. crteža\", u\"Sadržaj\", u\"Osovina\", u\"Razmera\"]\n        values = [CFG[\"PROJEKAT\"], CFG[\"NASLOV\"], CFG[\"BROJ_CRTEZA\"], content,\n                  u\"{0}   (grupa: {1})\".format(meta[\"alignment\"], meta[\"slg\"]),\n                  u\"{0}          List {1} / {2}          Datum {3}\".format(\n                      scale_txt, no, total, meta[\"date\"])]\n        rh = (TB[3] - TB[1]) / len(labels)\n        for i, (l, v) in enumerate(zip(labels, values)):\n            y = TB[3] - (i + 1) * rh\n            if i:\n                cv.line(TB[0], y + rh, TB[2], y + rh, \"DOK-OKVIR\")\n            cv.text(TB[0] + 1.5, y + rh / 2.0, l, 2.2, \"ML\", layer=\"DOK-TEKST\", color=C_HEADER)\n            cv.text(TB[0] + 26.5, y + rh / 2.0, v, 2.5 if i == 0 else 2.2, \"ML\", layer=\"DOK-TEKST\")\n        cv.line(TB[0] + 25, TB[1], TB[0] + 25, TB[3], \"DOK-OKVIR\")\n    cv.rect(NOTE[0], NOTE[1], NOTE[2], NOTE[3], \"DOK-OKVIR\")\n    cv.text(NOTE[0] + 2, NOTE[3] - 2, method_note(meta), 2.2, \"TL\",\n            width=NOTE[2] - NOTE[0] - 4, layer=\"DOK-TEKST\")\n\n\ndef method_note(meta):\n    return (u\"NAPOMENA – metoda proračuna: srednje površine poprečnih profila\\n\"\n            u\"V(i) = (A(i-1) + A(i)) / 2 × L(i),     L(i) = St(i) − St(i-1)\\n\"\n            u\"A – površina materijala u poprečnom profilu (Civil 3D lista materijala: {0})\\n\"\n            u\"Zaokruživanje: A na 0.01 m², St i L na 0.001 m, V na 0.01 m³ \"\n            u\"(proračun se može proveriti ručno sa prikazanim vrednostima).\").format(meta[\"mlist\"])\n\n\ndef draw_section_panel(cv, sec, slot, mats):\n    px0, py0, px1, py1 = panel_box(slot)\n    x = px0 + 2\n    cv.rect(slot[0], slot[1], slot[2], slot[3], \"DOK-OKVIR\")\n    cv.line(px0, py0, px0, py1, \"DOK-OKVIR\")\n    cv.text(x, py1 - 3, u\"POPREČNI PROFIL {0}\\nSt. {1}     R 1:{2}\".format(\n        sec[\"name\"], fmt_sta(sec[\"sta\"]), sec[\"scale\"]), 3.0, \"TL\", layer=\"DOK-TEKST\", color=C_TITLE)\n    rows = [[u\"Količine\"], [u\"Materijal\", u\"Površina\\n[m²]\", u\"Zapremina\\n[m³]\", u\"Ukupna zapr.\\n[m³]\"]]\n    heights = [6.0, 9.0]\n    colors = [C_TITLE, C_HEADER]\n    for i, m in enumerate(mats):\n        rows.append([m, fmt(sec[\"A\"][i]), fmt(sec[\"V\"][i]), fmt(sec[\"cum\"][i])])\n        heights.append(ROW_H)\n        colors.append(None)\n    y = draw_table(cv, x, py1 - 16, SEC_COLS, rows, heights, colors)\n\n    p = sec[\"prev\"]\n    if p is None:\n        lines = [u\"Proračun zapremine:\", u\"Početni profil – nema prethodnog profila.\",\n                 u\"V = 0.00 m³\"]\n    else:\n        lines = [u\"Proračun zapremine (metoda srednjih površina):\",\n                 u\"L = {0} − {1} = {2} m\".format(fmt(sec[\"sta_r\"], 3), fmt(p[\"sta_r\"], 3), fmt(sec[\"L\"], 3)),\n                 u\"V = (A({0}) + A({1})) / 2 × L\".format(p[\"name\"], sec[\"name\"])]\n        for i, m in enumerate(mats):\n            if len(mats) > 1:\n                lines.append(u\"{0}:\".format(m))\n            lines.append(u\"V = ({0} + {1}) / 2 × {2}\".format(fmt(p[\"A\"][i]), fmt(sec[\"A\"][i]), fmt(sec[\"L\"], 3)))\n            lines.append(u\"   = {0} × {1} = {2} m³\".format(fmt(sec[\"avg\"][i], 3), fmt(sec[\"L\"], 3), fmt(sec[\"V\"][i])))\n            lines.append(u\"ΣV = {0} + {1} = {2} m³\".format(fmt(sec[\"cum_prev\"][i]), fmt(sec[\"V\"][i]), fmt(sec[\"cum\"][i])))\n    cv.text(x, y - 4, u\"\\n\".join(lines), 2.2, \"TL\", width=PANEL_W - 4, layer=\"DOK-TEKST\")\n\n\ndef draw_summary_page(cv, page, sections, mats, totals, first, meta):\n    head = [u\"Profil\", u\"Stacionaža\\n[km+m]\", u\"Rastojanje\\nL [m]\", u\"Površina\\nA [m²]\",\n            u\"Sr. površina\\n(A1+A2)/2 [m²]\", u\"Zapremina\\nV [m³]\", u\"Ukupno\\nΣV [m³]\"]\n    rows, heights, colors = [head], [SUM_HEADER_H], [C_HEADER]\n    for r in page:\n        if r[0] == \"mat\":\n            rows.append([u\"Materijal: {0}\".format(mats[r[1]])]); colors.append(C_TITLE)\n        elif r[0] == \"row\":\n            i, sec = r[1], r[2]\n            first_sec = sec[\"prev\"] is None\n            rows.append([sec[\"name\"], fmt_sta(sec[\"sta\"]),\n                         u\"–\" if first_sec else fmt(sec[\"L\"], 3), fmt(sec[\"A\"][i]),\n                         u\"–\" if first_sec else fmt(sec[\"avg\"][i], 3),\n                         u\"–\" if first_sec else fmt(sec[\"V\"][i]), fmt(sec[\"cum\"][i])])\n            colors.append(None)\n        elif r[0] == \"total\":\n            i = r[1]\n            rows.append([u\"UKUPNO {0}\".format(mats[i]) if len(mats) > 1 else u\"UKUPNO\",\n                         u\"\", fmt(sections[-1][\"sta_r\"] - sections[0][\"sta_r\"], 3), u\"\", u\"\",\n                         fmt(totals[i]), fmt(totals[i])])\n            colors.append(C_TITLE)\n        else:\n            rows.append([u\"SVEGA SVI MATERIJALI: {0} m³\".format(fmt(sum(totals)))]); colors.append(C_TITLE)\n        heights.append(ROW_H)\n    cv.text(SUM_X, SUM_TOP + 3.5, u\"REKAPITULACIJA KOLIČINA ISKOPA\", 3.5, \"BL\",\n            layer=\"DOK-TEKST\", color=C_TITLE)\n    draw_table(cv, SUM_X, SUM_TOP, SUM_COLS, rows, heights, colors)\n\n    if first:\n        x = SUM_X + sum(SUM_COLS) + 8\n        lines = [u\"Osovina: {0}\".format(meta[\"alignment\"]),\n                 u\"Grupa poprečnih preseka: {0}\".format(meta[\"slg\"]),\n                 u\"Lista materijala: {0}\".format(meta[\"mlist\"]),\n                 u\"Broj profila: {0}   (St. {1} – {2})\".format(\n                     len(sections), fmt_sta(sections[0][\"sta\"]), fmt_sta(sections[-1][\"sta\"])),\n                 u\"\",\n                 u\"Metoda: srednje površine poprečnih profila\",\n                 u\"V(i) = (A(i-1) + A(i)) / 2 × L(i)\",\n                 u\"L(i) = St(i) − St(i-1)\",\n                 u\"ΣV = Σ V(i)\",\n                 u\"\"]\n        for i, m in enumerate(mats):\n            lines.append(u\"Ukupna zapremina – {0}: {1} m³\".format(m, fmt(totals[i])))\n        if meta[\"control\"]:\n            lines += [u\"\", u\"KONTROLA (zapreminska površina TIN – TIN):\"]\n            tot = sum(totals)\n            for name, cut, fill in meta[\"control\"]:\n                d = tot - cut\n                pct = (d / cut * 100.0) if cut else 0.0\n                lines.append(u\"„{0}“: iskop = {1} m³, nasip = {2} m³\".format(name, fmt(cut), fmt(fill)))\n                lines.append(u\"   razlika profili − površina = {0} m³ ({1} %)\".format(fmt(d), fmt(pct, 2)))\n        cv.text(x, SUM_TOP, u\"\\n\".join(lines), 2.5, \"TL\", width=FRAME[2] - x - 4, layer=\"DOK-TEKST\")\n\n\ndef draw_all(cv, sections, mats, meta):\n    totals = compute_quantities(sections, mats)\n    S, sheets = plan_sheets(sections)\n    pages = plan_summary(sections, mats)\n    total = len(sheets) + len(pages)\n    pre = CFG[\"PREFIKS_LEJAUTA\"]\n    names = []\n    for n, sheet in enumerate(sheets):\n        secs = [it[0] for it in sheet]\n        name = u\"{0}{1:02d} {2}\".format(pre, n + 1, u\"-\".join(s[\"name\"] for s in secs))\n        names.append(name)\n        cv.begin_sheet(name)\n        scales = sorted(set(s[\"scale\"] for s in secs))\n        draw_frame(cv, n + 1, total, u\"Poprečni profili \" + u\", \".join(s[\"name\"] for s in secs),\n                   u\", \".join(u\"1:{0}\".format(s) for s in scales), meta)\n        for sec, slot in sheet:\n            cv.viewport(vp_fit(vp_box(slot), sec), sec)\n            draw_section_panel(cv, sec, slot, mats)\n    for k, page in enumerate(pages):\n        name = u\"{0}Rekap_{1:02d}\".format(pre, k + 1)\n        names.append(name)\n        cv.begin_sheet(name)\n        draw_frame(cv, len(sheets) + k + 1, total, u\"Rekapitulacija količina iskopa\", u\"–\", meta)\n        draw_summary_page(cv, page, sections, mats, totals, k == 0, meta)\n    return S, names, totals\n\n\n# =====================================================================\n# CIVIL 3D DEO\n# =====================================================================\n# =====================================================================\n# DIJALOZI (WinForms) - rade u Dynamo-u (CPython3 / IronPython2)\n# =====================================================================\nNEW_LIST = u\"<Nova lista materijala>\"\nNO_BANDS = u\"(bez traka)\"\nNONE_SRC = u\"(nijedan)\"\n\n\ndef _wf():\n    import clr\n    clr.AddReference(\"System.Windows.Forms\")\n    clr.AddReference(\"System.Drawing\")\n    import System.Windows.Forms as F\n    import System.Drawing as D\n    return F, D\n\n\ndef _guess(names, keys, default_idx=0):\n    \"\"\"Najbolje poklapanje imena: tačno > počinje sa > sadrži.\"\"\"\n    low = [n.lower().strip() for n in names]\n    for test in (lambda n, k: n == k, lambda n, k: n.startswith(k), lambda n, k: k in n):\n        for k in keys:\n            for i, n in enumerate(low):\n                if test(n, k):\n                    return i\n    return default_idx if names else -1\n\n\ndef _combo(F, D, form, x, y, w, items, sel):\n    c = F.ComboBox()\n    c.DropDownStyle = F.ComboBoxStyle.DropDownList\n    c.Location = D.Point(x, y)\n    c.Width = w\n    for it in items:\n        c.Items.Add(it)\n    if items:\n        c.SelectedIndex = max(0, min(sel, len(items) - 1))\n    form.Controls.Add(c)\n    return c\n\n\ndef _label(F, D, form, x, y, text, w=170, bold=False):\n    l = F.Label()\n    l.Text = text\n    l.Location = D.Point(x, y + 3)\n    l.Size = D.Size(w, 20)\n    if bold:\n        l.Font = D.Font(form.Font, D.FontStyle.Bold)\n    form.Controls.Add(l)\n    return l\n\n\ndef _buttons(F, D, form, y):\n    ok = F.Button()\n    ok.Text = u\"U redu\"\n    ok.DialogResult = F.DialogResult.OK\n    ok.Location = D.Point(form.ClientSize.Width - 200, y)\n    ok.Width = 90\n    ca = F.Button()\n    ca.Text = u\"Otkaži\"\n    ca.DialogResult = F.DialogResult.Cancel\n    ca.Location = D.Point(form.ClientSize.Width - 100, y)\n    ca.Width = 90\n    form.Controls.Add(ok)\n    form.Controls.Add(ca)\n    form.AcceptButton = ok\n    form.CancelButton = ca\n\n\ndef _new_form(F, D, title, w, h):\n    f = F.Form()\n    f.Text = title\n    f.Font = D.Font(\"Segoe UI\", 9.0)\n    f.FormBorderStyle = F.FormBorderStyle.FixedDialog\n    f.MaximizeBox = False\n    f.MinimizeBox = False\n    f.StartPosition = F.FormStartPosition.CenterScreen\n    f.ClientSize = D.Size(w, h)\n    return f\n\n\ndef settings_dialog(d, show=None):\n    \"\"\"d: sv_styles, sv_default, band_sets, band_default, mlists, surfaces,\n    color (r,g,b), pick_color() -> (r,g,b) ili None.\n    show(form) -> True ako je potvrđeno. Vraća dict ili None.\"\"\"\n    F, D = _wf()\n    f = _new_form(F, D, u\"Dokaznica iskopa – podešavanja\", 560, 420)\n    X1, X2, W = 15, 200, 340\n    y = 15\n    _label(F, D, f, X1, y, u\"Prikaz poprečnih preseka\", 400, True); y += 28\n    _label(F, D, f, X1, y, u\"Stil prikaza preseka:\")\n    c_style = _combo(F, D, f, X2, y, W, d[\"sv_styles\"], d[\"sv_default\"]); y += 32\n    _label(F, D, f, X1, y, u\"Set traka (kote, rastojanja):\")\n    c_band = _combo(F, D, f, X2, y, W, [NO_BANDS] + d[\"band_sets\"], d[\"band_default\"] + 1); y += 42\n\n    _label(F, D, f, X1, y, u\"Materijal (Compute Materials)\", 400, True); y += 28\n    _label(F, D, f, X1, y, u\"Lista materijala:\")\n    c_list = _combo(F, D, f, X2, y, W, d[\"mlists\"] + [NEW_LIST], 0); y += 32\n    _label(F, D, f, X1, y, u\"Naziv nove liste / materijala:\")\n    t_list = F.TextBox(); t_list.Location = D.Point(X2, y); t_list.Width = 165; t_list.Text = u\"Dokaznica\"\n    t_mat = F.TextBox(); t_mat.Location = D.Point(X2 + 175, y); t_mat.Width = 165; t_mat.Text = u\"Iskop\"\n    f.Controls.Add(t_list); f.Controls.Add(t_mat); y += 32\n    _label(F, D, f, X1, y, u\"Postojeći teren (ispod njega):\")\n    c_eg = _combo(F, D, f, X2, y, W, d[\"surfaces\"],\n                  _guess(d[\"surfaces\"], [u\"nulto\", u\"teren\", u\"postoj\", u\"existing\", u\"eg\"])); y += 32\n    _label(F, D, f, X1, y, u\"Površina iskopa (iznad nje):\")\n    c_dg = _combo(F, D, f, X2, y, W, d[\"surfaces\"],\n                  _guess(d[\"surfaces\"], [u\"iskop\", u\"projekt\", u\"dno\", u\"design\"], 1)); y += 32\n\n    def on_list(sender, args):\n        new = c_list.SelectedItem == NEW_LIST\n        for c in (t_list, t_mat, c_eg, c_dg):\n            c.Enabled = new\n    c_list.SelectedIndexChanged += on_list\n    on_list(None, None)\n\n    _label(F, D, f, X1, y + 8, u\"Boja materijala (šrafura):\", 400, True); y += 36\n    chk = F.CheckBox(); chk.Text = u\"Promeni boju\"; chk.Location = D.Point(X1, y); chk.Width = 170\n    chk.Checked = False\n    f.Controls.Add(chk)\n    sw = F.Panel(); sw.Location = D.Point(X2, y); sw.Size = D.Size(60, 24)\n    sw.BorderStyle = F.BorderStyle.FixedSingle\n    state = {\"rgb\": tuple(d[\"color\"])}\n    sw.BackColor = D.Color.FromArgb(*state[\"rgb\"])\n    f.Controls.Add(sw)\n    b = F.Button(); b.Text = u\"Izaberi boju...\"; b.Location = D.Point(X2 + 70, y); b.Width = 120\n    f.Controls.Add(b)\n\n    def on_color(sender, args):\n        rgb = d[\"pick_color\"](state[\"rgb\"])\n        if rgb:\n            state[\"rgb\"] = tuple(rgb)\n            sw.BackColor = D.Color.FromArgb(*state[\"rgb\"])\n            chk.Checked = True\n    b.Click += on_color\n    y += 50\n    _buttons(F, D, f, y)\n\n    if show is None or not show(f):\n        return f if show is None else None\n    new = c_list.SelectedItem == NEW_LIST\n    return {\n        \"sv_style\": c_style.SelectedItem,\n        \"band_set\": None if c_band.SelectedIndex <= 0 else c_band.SelectedItem,\n        \"mlist\": None if new else c_list.SelectedItem,\n        \"new_list\": t_list.Text.strip() or u\"Dokaznica\",\n        \"new_mat\": t_mat.Text.strip() or u\"Iskop\",\n        \"eg\": c_eg.SelectedItem, \"dg\": c_dg.SelectedItem,\n        \"recolor\": bool(chk.Checked), \"rgb\": state[\"rgb\"],\n    }\n\n\ndef bands_dialog(bands, sources, s1_default, s2_default, show=None):\n    \"\"\"Izbor izvora (Section 1 / Section 2) za svaku traku. Vraća listu (s1, s2) imena.\"\"\"\n    F, D = _wf()\n    items = [NONE_SRC] + list(sources)\n    h = 90 + 32 * len(bands) + 50\n    f = _new_form(F, D, u\"Dokaznica iskopa – izvori podataka za trake\", 720, h)\n    _label(F, D, f, 15, 12, u\"Za svaku traku izaberite izvor preseka (kao u Civil 3D čarobnjaku):\", 690)\n    _label(F, D, f, 15, 40, u\"Traka\", 250, True)\n    _label(F, D, f, 280, 40, u\"Section 1\", 200, True)\n    _label(F, D, f, 495, 40, u\"Section 2\", 200, True)\n    y = 70\n    rows = []\n    for name in bands:\n        _label(F, D, f, 15, y, name, 255)\n        lo = name.lower()\n        s1 = s2_default if (u\"projekt\" in lo or u\"design\" in lo) else s1_default\n        c1 = _combo(F, D, f, 280, y, 205, items, items.index(s1) if s1 in items else 0)\n        c2 = _combo(F, D, f, 495, y, 205, items, items.index(s2_default) if s2_default in items else 0)\n        rows.append((c1, c2))\n        y += 32\n    _buttons(F, D, f, y + 15)\n    if show is None or not show(f):\n        return f if show is None else None\n    out = []\n    for c1, c2 in rows:\n        out.append((None if c1.SelectedItem == NONE_SRC else c1.SelectedItem,\n                    None if c2.SelectedItem == NONE_SRC else c2.SelectedItem))\n    return out\n\n\ndef _civ(name):\n    \"\"\"Pronalazi Civil 3D tip/enum po imenu u poznatim imenskim prostorima.\"\"\"\n    import importlib\n    for modname in (\"Autodesk.Civil\", \"Autodesk.Civil.DatabaseServices\",\n                    \"Autodesk.Civil.DatabaseServices.Styles\"):\n        try:\n            mod = importlib.import_module(modname)\n            if hasattr(mod, name):\n                return getattr(mod, name)\n        except Exception:\n            pass\n    return None\n\n\ndef _prop_info(obj, name, need_read):\n    \"\"\"Traži svojstvo kroz hijerarhiju klasa (za pythonnet: izvedena klasa može imati samo setter/getter).\"\"\"\n    from System.Reflection import BindingFlags\n    flags = BindingFlags.Public | BindingFlags.Instance | BindingFlags.DeclaredOnly\n    t = obj.GetType()\n    while t is not None:\n        p = t.GetProperty(name, flags)\n        if p is not None and (p.CanRead if need_read else p.CanWrite):\n            return p\n        t = t.BaseType\n    return None\n\n\ndef get_prop(obj, name):\n    \"\"\"Čita svojstvo; ako pythonnet javi 'property cannot be read', čita preko refleksije.\"\"\"\n    try:\n        return getattr(obj, name)\n    except Exception:\n        p = _prop_info(obj, name, True)\n        if p is None:\n            raise\n        return p.GetValue(obj, None)\n\n\ndef set_prop(obj, name, value):\n    try:\n        setattr(obj, name, value)\n    except Exception:\n        p = _prop_info(obj, name, False)\n        if p is None:\n            raise\n        p.SetValue(obj, value, None)\n\n\ndef obj_name(obj):\n    try:\n        return get_prop(obj, \"Name\")\n    except Exception:\n        return u\"?\"\n\n\ndef _style_map(tr, coll, log=None):\n    out = []\n    if coll is None:\n        return out\n    for sid in coll:\n        try:\n            out.append((obj_name(tr.GetObject(sid, OpenModeRef[0].ForRead)), sid))\n        except Exception as e:\n            if log is not None:\n                log.append(u\"Upozorenje: stil nije pročitan: {0}\".format(e))\n    return out\n\n\nOpenModeRef = [None]\n\n\ndef recolor_style(tr, style_id, color, log):\n    \"\"\"Postavlja boju na sve komponente prikaza stila. Metode GetDisplayStyle*(enum) se\n    pronalaze refleksijom, pa ne zavise od imena enum tipova u Civil 3D API-ju.\"\"\"\n    from System import Enum, Array, Object\n    st = tr.GetObject(style_id, OpenModeRef[0].ForWrite)\n    n, errs = 0, []\n    for mi in st.GetType().GetMethods():\n        if not mi.Name.startswith(\"GetDisplayStyle\"):\n            continue\n        ps = mi.GetParameters()\n        if len(ps) != 1 or not ps[0].ParameterType.IsEnum:\n            continue\n        for v in Enum.GetValues(ps[0].ParameterType):\n            try:\n                ds = mi.Invoke(st, Array[Object]([v]))\n                set_prop(ds, \"Color\", color)\n                n += 1\n            except Exception as e:\n                errs.append(u\"{0}({1}): {2}\".format(mi.Name, v, e))\n    if n == 0:\n        log.append(u\"Upozorenje: boja stila '{0}' nije promenjena – promenite ručno. {1}\".format(\n            obj_name(st), u\"; \".join(errs[:3])))\n    else:\n        log.append(u\"Stil '{0}': boja postavljena na {1} komponenti prikaza.\".format(obj_name(st), n))\n    return n\n\n\ndef run_civil(IN):\n    import clr\n    for ref in (\"AcMgd\", \"AcCoreMgd\", \"AcDbMgd\", \"AecBaseMgd\", \"AecPropDataMgd\", \"AeccDbMgd\"):\n        clr.AddReference(ref)\n    from Autodesk.AutoCAD.ApplicationServices import Application\n    from Autodesk.AutoCAD.DatabaseServices import (\n        OpenMode, Line, Polyline, MText, Viewport, AttachmentPoint, LayoutManager,\n        PlotSettings, PlotSettingsValidator, PlotPaperUnit, PlotRotation, PlotType,\n        StdScaleType, LayerTableRecord, TextStyleTableRecord, BlockReference, ObjectId)\n    from Autodesk.AutoCAD.Geometry import Point2d, Point3d, Vector3d, Matrix3d\n    from Autodesk.AutoCAD.EditorInput import PromptEntityOptions, PromptPointOptions, PromptStatus\n    from Autodesk.AutoCAD.Colors import Color, ColorMethod\n    from Autodesk.AutoCAD.GraphicsInterface import FontDescriptor\n    from Autodesk.Civil.ApplicationServices import CivilApplication\n    from Autodesk.Civil.DatabaseServices import Alignment, SectionView, TinVolumeSurface\n    OpenModeRef[0] = OpenMode\n\n    doc = Application.DocumentManager.MdiActiveDocument\n    db, ed = doc.Database, doc.Editor\n    civdoc = CivilApplication.ActiveDocument\n    log = []\n    R, W = OpenMode.ForRead, OpenMode.ForWrite\n\n    import io, os, tempfile\n    trace_path = os.path.join(tempfile.gettempdir(), u\"dokaznica_trace.txt\")\n    io.open(trace_path, \"w\", encoding=\"utf-8\").close()\n\n    def trace(msg):\n        with io.open(trace_path, \"a\", encoding=\"utf-8\") as f_:\n            f_.write(u\"{0}\\n\".format(msg))\n\n    def show_modal(form):\n        from System.Windows.Forms import DialogResult\n        return Application.ShowModalDialog(form) == DialogResult.OK\n\n    # ---------- 1. izbor osovine ----------\n    aln_name = u\"{0}\".format(IN[0]).strip() if IN and IN[0] else u\"\"\n    aln_id = None\n    if aln_name:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            ids = list(civdoc.GetAlignmentIds())\n            for sid in civdoc.GetSiteIds():\n                ids += list(tr.GetObject(sid, R).GetAlignmentIds())\n            for i in ids:\n                if tr.GetObject(i, R).Name == aln_name:\n                    aln_id = i\n        finally:\n            tr.Dispose()\n        if aln_id is None:\n            return [u\"GREŠKA: osovina '{0}' nije pronađena.\".format(aln_name)]\n    else:\n        peo = PromptEntityOptions(u\"\\nIzaberite osovinu (alignment) za dokaznicu: \")\n        peo.SetRejectMessage(u\"\\nIzabrani objekat nije osovina.\")\n        peo.AddAllowedClass(clr.GetClrType(Alignment), True)\n        res = ed.GetEntity(peo)\n        if res.Status != PromptStatus.OK:\n            return [u\"Prekinuto – osovina nije izabrana. (Ime osovine možete upisati na ulaz IN[0].)\"]\n        aln_id = res.ObjectId\n\n    trace(u\"1 osovina izabrana\")\n    # ---------- 2. čitanje podataka za dijalog ----------\n    tr = db.TransactionManager.StartTransaction()\n    try:\n        aln = tr.GetObject(aln_id, R)\n        aln_name = aln.Name\n        slg = None\n        for gid in aln.GetSampleLineGroupIds():\n            g = tr.GetObject(gid, R)\n            if CFG[\"GRUPA_PRESEKA\"]:\n                if g.Name == CFG[\"GRUPA_PRESEKA\"]:\n                    slg = g\n            elif slg is None or (slg.MaterialLists.Count == 0 and g.MaterialLists.Count > 0):\n                slg = g\n        if slg is None:\n            return [u\"GREŠKA: osovina '{0}' nema grupu poprečnih preseka (sample lines).\".format(aln_name)]\n        slg_id, slg_name = slg.ObjectId, slg.Name\n        mlist_names = [slg.MaterialLists[i].Name for i in range(slg.MaterialLists.Count)]\n\n        sv_styles = _style_map(tr, civdoc.Styles.SectionViewStyles, log)\n        band_sets = _style_map(tr, getattr(civdoc.Styles, \"SectionViewBandSetStyles\", None), log)\n        trace(u\"2 stilova: {0}, setova traka: {1}\".format(len(sv_styles), len(band_sets)))\n        surfaces = []\n        for sid in civdoc.GetSurfaceIds():\n            s = tr.GetObject(sid, R)\n            if not isinstance(s, TinVolumeSurface):\n                surfaces.append((s.Name, sid))\n        trace(u\"2 preseci po uzorkovanim linijama\")\n        sec_ids = {}   # slid -> {ime izvora: id preseka}; ime preseka je \"<profil>-<izvor>\"\n        source_names = []\n\n        lines = []   # (slid, ime, stacionaža, postojeći prikaz ili None)\n        for slid in slg.GetSampleLineIds():\n            sl = tr.GetObject(slid, R)\n            d_ = {}\n            try:\n                surf_names = sorted([n_ for n_, i_ in surfaces], key=len, reverse=True)\n                for sid in sl.GetSectionIds():\n                    full = obj_name(tr.GetObject(sid, R))\n                    # ime preseka -> ime površine (najduže poklapanje), inače bez prefiksa profila\n                    nm = next((sn for sn in surf_names if full == sn or full.endswith(sn)), None)\n                    if nm is None:\n                        nm = full[len(sl.Name) + 1:] if full.startswith(sl.Name + u\"-\") else full\n                    d_[nm] = sid\n                    if not sec_ids:\n                        trace(u\"2 presek '{0}' -> izvor '{1}'\".format(full, nm))\n                    if nm not in source_names:\n                        source_names.append(nm)\n            except Exception as e:\n                log.append(u\"Upozorenje: preseci za {0}: {1}\".format(sl.Name, e))\n            sec_ids[slid] = d_\n            vids = sl.GetSectionViewIds()\n            keep = None\n            if CFG[\"KORISTI_POSTOJECE_PRIKAZE\"]:\n                for k in range(vids.Count):\n                    if not tr.GetObject(vids[k], R).Name.startswith(u\"DOK-\"):\n                        keep = vids[k]\n                        break\n            lines.append((slid, sl.Name, sl.Station, keep))\n        if not lines:\n            return [u\"GREŠKA: grupa preseka nema uzorkovanih linija.\"]\n        lines.sort(key=lambda t: t[2])\n    finally:\n        tr.Dispose()\n\n    trace(u\"3 dijalog podešavanja\")\n    # ---------- 3. dijalog podešavanja ----------\n    names = [n for n, i in sv_styles]\n    bnames = [n for n, i in band_sets]\n    picked = {\"acad\": None}\n\n    def pick_color(rgb):\n        from Autodesk.AutoCAD.Windows import ColorDialog\n        from System.Windows.Forms import DialogResult\n        cd = ColorDialog()\n        cd.Color = Color.FromRgb(rgb[0], rgb[1], rgb[2])\n        if cd.ShowDialog() == DialogResult.OK:\n            picked[\"acad\"] = cd.Color\n            cv_ = cd.Color.ColorValue\n            return (cv_.R, cv_.G, cv_.B)\n        return None\n\n    ui = settings_dialog({\n        \"sv_styles\": names,\n        \"sv_default\": names.index(CFG[\"STIL_PRIKAZA_PRESEKA\"]) if CFG[\"STIL_PRIKAZA_PRESEKA\"] in names\n        else max(0, _guess(names, [u\"putevi-srb\", u\"srb\"])),\n        \"band_sets\": bnames,\n        \"band_default\": bnames.index(CFG[\"SET_TRAKA\"]) if CFG[\"SET_TRAKA\"] in bnames\n        else _guess(bnames, [u\"putevi-srb\", u\"srb\", u\"putevi\"], -1),\n        \"mlists\": mlist_names,\n        \"surfaces\": [n for n, i in surfaces],\n        \"color\": CFG[\"BOJA_MATERIJALA\"], \"pick_color\": pick_color}, show=show_modal)\n    if ui is None:\n        return [u\"Prekinuto u dijalogu.\"]\n    sv_style_id = dict(sv_styles).get(ui[\"sv_style\"])\n    band_set_id = dict(band_sets).get(ui[\"band_set\"]) if ui[\"band_set\"] else None\n\n    trace(u\"4 tačka umetanja (dijalog: {0})\".format(ui))\n    # ---------- 4. tačka umetanja ----------\n    base = None\n    if any(t[3] is None for t in lines):\n        ppo = PromptPointOptions(u\"\\nIzaberite tačku umetanja za prikaze poprečnih preseka \"\n                                 u\"(ređaju se udesno, {0} u redu): \".format(CFG[\"PRIKAZA_U_REDU\"]))\n        res = ed.GetPoint(ppo)\n        if res.Status != PromptStatus.OK:\n            return [u\"Prekinuto – tačka umetanja nije izabrana.\"]\n        base = res.Value\n\n    trace(u\"4 zaključavanje dokumenta\")\n    lock = doc.LockDocument()\n    old_lcv = None\n    try:\n        # ---------- 5a. lista materijala (nova ili postojeća) ----------\n        trace(u\"5a lista materijala: {0}\".format(ui[\"mlist\"] or u\"NOVA\"))\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            slg_w = tr.GetObject(slg_id, W)\n            mls = slg_w.MaterialLists\n            ml = None\n            if ui[\"mlist\"] is None:\n                surf = dict(surfaces)\n                eg_id, dg_id = surf.get(ui[\"eg\"]), surf.get(ui[\"dg\"])\n                if eg_id is None or dg_id is None or eg_id == dg_id:\n                    return [u\"GREŠKA: za novu listu materijala izaberite dve različite površine.\"]\n                lname = ui[\"new_list\"]\n                k = 2\n                while lname in mlist_names:\n                    lname = u\"{0} ({1})\".format(ui[\"new_list\"], k); k += 1\n                try:\n                    trace(u\"5a mls.Add\"); ml = mls.Add(lname)\n                    trace(u\"5a ml.Add\"); mat = ml.Add(ui[\"new_mat\"])\n                    qt = _civ(\"MaterialQuantityType\")\n                    if qt is not None:\n                        trace(u\"5a QuantityType\"); mat.QuantityType = qt.Cut\n                    cond = _civ(\"MaterialConditionType\")\n                    trace(u\"5a item teren\"); it1 = mat.Add(eg_id)\n                    it1.Condition = cond.Below      # ispod postojećeg terena\n                    trace(u\"5a item iskop\"); it2 = mat.Add(dg_id)\n                    it2.Condition = cond.Above      # iznad površine iskopa\n                except Exception as e:\n                    return [u\"GREŠKA pri pravljenju liste materijala: {0}\".format(e),\n                            u\"Napravite je ručno: Analyze > Compute Materials \"\n                            u\"(teren = Below, iskop = Above), pa pokrenite ponovo.\"] + log\n                log.append(u\"Napravljena lista materijala '{0}' / '{1}' (ispod '{2}', iznad '{3}').\".format(\n                    lname, ui[\"new_mat\"], ui[\"eg\"], ui[\"dg\"]))\n            else:\n                for i in range(mls.Count):\n                    if mls[i].Name == ui[\"mlist\"]:\n                        ml = mls[i]\n            mat_keys = [(ml.Guid, ml[j].Guid, ml[j].Name, ml.Name) for j in range(ml.Count)]\n            mats = [k_[2] for k_ in mat_keys]\n            mlist_used = ml.Name\n            cur_styles = []\n            for j in range(ml.Count):\n                try:\n                    cur_styles.append(get_prop(ml[j], \"ShapeStyleId\"))\n                except Exception:\n                    cur_styles.append(ObjectId.Null)\n            tr.Commit()\n        finally:\n            tr.Dispose()\n        trace(u\"5a gotovo\")\n\n        # ---------- 5b. boja materijala: kopija stila \"DOK-<materijal>\" ----------\n        if ui[\"recolor\"]:\n            rgb = ui[\"rgb\"]\n            col = picked[\"acad\"] or Color.FromRgb(rgb[0], rgb[1], rgb[2])\n            new_styles = []\n            tr = db.TransactionManager.StartTransaction()\n            try:\n                shape_styles = civdoc.Styles.ShapeStyles\n                existing = dict((obj_name(tr.GetObject(sid, R)), sid) for sid in shape_styles)\n                for j, mname in enumerate(mats):\n                    new_name = u\"DOK-{0}\".format(mname)\n                    sty = existing.get(new_name)\n                    try:\n                        if sty is None:\n                            cur = cur_styles[j]\n                            if cur.IsNull:\n                                cur = list(shape_styles)[0]\n                            trace(u\"5b CopyAsSibling {0}\".format(new_name))\n                            sty = tr.GetObject(cur, W).CopyAsSibling(new_name)\n                        trace(u\"5b recolor {0}\".format(new_name))\n                        recolor_style(tr, sty, col, log)\n                    except Exception as e:\n                        sty = None\n                        log.append(u\"Upozorenje: stil '{0}' nije napravljen: {1}\".format(new_name, e))\n                    new_styles.append(sty)\n                tr.Commit()\n            finally:\n                tr.Dispose()\n            tr = db.TransactionManager.StartTransaction()\n            try:\n                slg_w = tr.GetObject(slg_id, W)\n                mls = slg_w.MaterialLists\n                for i in range(mls.Count):\n                    if mls[i].Name == mlist_used:\n                        ml = mls[i]\n                for j in range(ml.Count):\n                    if new_styles[j] is None:\n                        continue\n                    try:\n                        trace(u\"5b ShapeStyleId {0}\".format(mats[j]))\n                        set_prop(ml[j], \"ShapeStyleId\", new_styles[j])\n                        log.append(u\"Materijal '{0}': stil 'DOK-{0}', boja {1}.\".format(mats[j], rgb))\n                    except Exception as e:\n                        log.append(u\"Upozorenje: stil materijala '{0}' nije dodeljen: {1}. Ručno: Sample Line \"\n                                   u\"Group Properties > Material List > Style = 'DOK-{0}'.\".format(mats[j], e))\n                tr.Commit()\n            finally:\n                tr.Dispose()\n        trace(u\"5b gotovo\")\n        ed.Regen()\n\n        # ---------- 6. prikazi preseka ----------\n        if base is not None:\n            trace(u\"6 brisanje starih DOK- prikaza\")\n            tr = db.TransactionManager.StartTransaction()\n            try:\n                for slid, name, sta, keep in lines:\n                    if keep is None:\n                        vids = tr.GetObject(slid, R).GetSectionViewIds()\n                        for k in range(vids.Count):\n                            v = tr.GetObject(vids[k], R)\n                            if v.Name.startswith(u\"DOK-\"):\n                                v.UpgradeOpen()\n                                v.Erase()\n                tr.Commit()\n            finally:\n                tr.Dispose()\n\n        band_map = None   # lista (Section1 ime, Section2 ime) po traci\n        gap = CFG[\"RAZMAK_PRIKAZA\"]\n        x, y = (base.X, base.Y) if base is not None else (0.0, 0.0)\n        row_bottom, row_limit, prev_right, n_in_row = None, None, None, 0\n        sections, sec_box0 = [], {}\n        for slid, name, sta, keep in lines:\n            box0 = None\n            if keep is not None:\n                svid = keep\n            else:\n                trace(u\"6 prikaz {0}\".format(name))\n                tr = db.TransactionManager.StartTransaction()\n                try:\n                    svid = SectionView.Create(u\"DOK-{0}-{1}\".format(aln_name, name), slid, Point3d(x, y, 0))\n                    tr.Commit()\n                finally:\n                    tr.Dispose()\n                # granice odmah posle pravljenja (pre promene stila/traka) - za dijagnostiku i rezervu\n                tr = db.TransactionManager.StartTransaction()\n                try:\n                    box0, src0, errs0 = view_extents(tr.GetObject(svid, R))\n                finally:\n                    tr.Dispose()\n                trace(u\"6 granice posle Create: {0}\".format(box0))\n                tr = db.TransactionManager.StartTransaction()\n                try:\n                    sv = tr.GetObject(svid, W)\n                    if sv_style_id is not None:\n                        sv.StyleId = sv_style_id\n                    if band_set_id is not None:\n                        try:\n                            trace(u\"6 ImportBandSetStyle\")\n                            sv.Bands.ImportBandSetStyle(band_set_id)\n                        except Exception as e:\n                            log.append(u\"Upozorenje: set traka za {0}: {1}\".format(name, e))\n                    tr.Commit()\n                finally:\n                    tr.Dispose()\n                if band_set_id is not None:\n                    if band_map is None:\n                        tr = db.TransactionManager.StartTransaction()\n                        try:\n                            items = tr.GetObject(svid, R).Bands.GetBottomBandItems()\n                            bn = [obj_name(tr.GetObject(get_prop(items[i], \"BandStyleId\"), R)) for i in range(items.Count)]\n                        finally:\n                            tr.Dispose()\n                        band_map = []\n                        if bn:\n                            band_map = bands_dialog(\n                                bn, source_names,\n                                ui[\"eg\"] if ui[\"eg\"] in source_names else (source_names[0] if source_names else None),\n                                ui[\"dg\"] if ui[\"dg\"] in source_names else None,\n                                show=show_modal) or []\n                    if band_map:\n                        trace(u\"6 izvori traka {0}\".format(name))\n                        tr = db.TransactionManager.StartTransaction()\n                        try:\n                            sv = tr.GetObject(svid, W)\n                            ids_ = sec_ids.get(slid, {})\n                            items = sv.Bands.GetBottomBandItems()\n                            for i in range(min(items.Count, len(band_map))):\n                                s1, s2 = band_map[i]\n                                if s1 in ids_:\n                                    set_prop(items[i], \"Section1Id\", ids_[s1])\n                                if s2 in ids_:\n                                    set_prop(items[i], \"Section2Id\", ids_[s2])\n                                if CFG[\"PROREDJIVANJE_TRAKA\"] > 0:\n                                    try:\n                                        set_prop(items[i], \"Weeding\", float(CFG[\"PROREDJIVANJE_TRAKA\"]))\n                                    except Exception as e:\n                                        if not sections:\n                                            log.append(u\"Upozorenje: proređivanje trake: {0}\".format(e))\n                                if not sections:\n                                    trace(u\"6 traka {0}: S1={1} ({2}), S2={3} ({4})\".format(\n                                        i, s1, s1 in ids_, s2, s2 in ids_))\n                            sv.Bands.SetBottomBandItems(items)\n                            tr.Commit()\n                        except Exception as e:\n                            log.append(u\"Upozorenje: izvori traka za {0}: {1}\".format(name, e))\n                        finally:\n                            tr.Dispose()\n            tr = db.TransactionManager.StartTransaction()\n            try:\n                sv = tr.GetObject(svid, R)\n                box, src, errs = view_extents(sv)\n                if box is None:\n                    ed.Regen()\n                    box, src, errs2 = view_extents(sv)\n                    errs += errs2\n                svname = sv.Name\n            finally:\n                tr.Dispose()\n            trace(u\"6 granice posle stila/traka: {0}\".format(box))\n            if box is None and keep is None and box0 is not None:\n                box, src = box0, u\"pre stila/traka – PROVERITI viewport\"\n                log.append(u\"Upozorenje: {0} – prikaz je prazan posle promene stila/traka, korišćene \"\n                           u\"granice pre promene.\".format(name))\n            if box is None:\n                return ([u\"GREŠKA: ne mogu da odredim granice prikaza preseka '{0}' (profil {1}).\".format(\n                    svname, name)] + errs + log)\n            sec_box0[name] = (box, src)\n            if keep is None:\n                # ne sme da zalazi u prethodni prikaz u redu niti u prethodni red -> pomeri ga\n                sx = (prev_right + gap - box[0]) if (prev_right is not None and box[0] < prev_right + gap) else 0.0\n                sy = (row_limit - gap - box[3]) if (row_limit is not None and box[3] > row_limit - gap) else 0.0\n                if sx or sy:\n                    trace(u\"6 pomeranje {0}: dx={1:.1f} dy={2:.1f}\".format(name, sx, sy))\n                    tr = db.TransactionManager.StartTransaction()\n                    try:\n                        tr.GetObject(svid, W).TransformBy(Matrix3d.Displacement(Vector3d(sx, sy, 0)))\n                        tr.Commit()\n                    finally:\n                        tr.Dispose()\n                    tr = db.TransactionManager.StartTransaction()\n                    try:\n                        nb, nsrc, nerr = view_extents(tr.GetObject(svid, R))\n                    finally:\n                        tr.Dispose()\n                    box = nb if nb is not None else (box[0] + sx, box[1] + sy, box[2] + sx, box[3] + sy)\n                    x, y = x + sx, y + sy\n                left_over, top_over = x - box[0], box[3] - y   # koliko prikaz viri levo/gore od tačke umetanja\n                prev_right = box[2]\n                row_bottom = box[1] if row_bottom is None else min(row_bottom, box[1])\n                n_in_row += 1\n                if n_in_row >= CFG[\"PRIKAZA_U_REDU\"]:\n                    row_limit = row_bottom\n                    x, y = base.X, row_bottom - gap - top_over\n                    row_bottom, prev_right, n_in_row = None, None, 0\n                else:\n                    x = box[2] + gap + left_over\n            sections.append({\"name\": name, \"sta\": sta, \"slid\": slid, \"svid\": svid})\n\n        # ---------- 6b. konačne granice svih prikaza (trake se iscrtavaju tek posle izmena) ----------\n        ed.Regen()\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            for sec in sections:\n                sv = tr.GetObject(sec[\"svid\"], R)\n                box, src, errs = view_extents(sv)\n                if box is None:\n                    box, src = sec_box0[sec[\"name\"]]\n                log.append(u\"{0}: prikaz '{1}' {2:.1f} x {3:.1f} m ({4})\".format(\n                    sec[\"name\"], sv.Name, box[2] - box[0], box[3] - box[1], src))\n                sec.update({\"w\": box[2] - box[0], \"h\": box[3] - box[1],\n                            \"cx\": (box[0] + box[2]) / 2.0, \"cy\": (box[1] + box[3]) / 2.0})\n        finally:\n            tr.Dispose()\n        trace(u\"6b konačne granice izmerene\")\n\n        try:\n            old_lcv = Application.GetSystemVariable(\"LAYOUTCREATEVIEWPORT\")\n            Application.SetSystemVariable(\"LAYOUTCREATEVIEWPORT\", 0)\n        except Exception:\n            pass\n\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            trace(u\"7 površine materijala\")\n            # ---------- 7. površine materijala ----------\n            for sec in sections:\n                sl = tr.GetObject(sec[\"slid\"], R)\n                areas = []\n                for lg, mg, mname, lname in mat_keys:\n                    a = 0.0\n                    try:\n                        msid, last = None, None\n                        for arg in (mg, mname):   # API: (Guid liste, Guid materijala); rezerva: ime\n                            try:\n                                msid = sl.GetMaterialSectionId(lg, arg)\n                                break\n                            except Exception as e:\n                                last = e\n                        if msid is None:\n                            raise last\n                        if not msid.IsNull:\n                            ms = tr.GetObject(msid, R)\n                            sp = ms.SectionPoints\n                            a = polygon_area([(sp[k].Location.X, sp[k].Location.Y) for k in range(sp.Count)])\n                    except Exception as e:\n                        log.append(u\"Upozorenje: {0}/{1}: {2}\".format(sec[\"name\"], mname, e))\n                    areas.append(a)\n                sec[\"areas\"] = areas\n            if all(a == 0 for sec in sections for a in sec[\"areas\"]):\n                log.append(u\"Upozorenje: sve površine materijala su 0 – ako je lista tek napravljena, \"\n                           u\"pokrenite skriptu još jednom (Civil 3D tada preračuna materijale).\")\n\n            # ---------- 8. kontrola: zapreminske površine ----------\n            control = []\n            for sid in civdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, R)\n                if isinstance(s, TinVolumeSurface):\n                    if CFG[\"KONTROLNA_POVRSINA\"] and s.Name != CFG[\"KONTROLNA_POVRSINA\"]:\n                        continue\n                    vp_ = s.GetVolumeProperties()\n                    control.append((s.Name, vp_.UnadjustedCutVolume, vp_.UnadjustedFillVolume))\n\n            meta = {\"alignment\": aln_name, \"slg\": slg_name, \"mlist\": mlist_used,\n                    \"date\": datetime.date.today().strftime(\"%d.%m.%Y\"), \"control\": control}\n\n            trace(u\"9 lejauti\")\n            # ---------- 9. lejauti ----------\n            lm = LayoutManager.Current\n            lm.CurrentLayout = \"Model\"\n            if CFG[\"OBRISI_STARE_LEJAUTE\"]:\n                ld = tr.GetObject(db.LayoutDictionaryId, R)\n                old = [e.Key for e in ld if e.Key.startswith(CFG[\"PREFIKS_LEJAUTA\"])]\n                for n in old:\n                    lm.DeleteLayout(n)\n\n            cv = CivilCanvas(db, tr, lm, locals_=dict(\n                OpenMode=OpenMode, Line=Line, Polyline=Polyline, MText=MText, Viewport=Viewport,\n                AttachmentPoint=AttachmentPoint, PlotSettings=PlotSettings,\n                PlotSettingsValidator=PlotSettingsValidator, PlotPaperUnit=PlotPaperUnit,\n                PlotRotation=PlotRotation, PlotType=PlotType, StdScaleType=StdScaleType,\n                LayerTableRecord=LayerTableRecord, TextStyleTableRecord=TextStyleTableRecord,\n                BlockReference=BlockReference, Point2d=Point2d, Point3d=Point3d,\n                Vector3d=Vector3d, Color=Color, ColorMethod=ColorMethod,\n                FontDescriptor=FontDescriptor), log=log)\n            S, names, totals = draw_all(cv, sections, mats, meta)\n            if names:\n                lm.CurrentLayout = names[0]\n            tr.Commit()\n            trace(u\"KRAJ\")\n        finally:\n            tr.Dispose()\n    finally:\n        if old_lcv is not None:\n            try:\n                Application.SetSystemVariable(\"LAYOUTCREATEVIEWPORT\", old_lcv)\n            except Exception:\n                pass\n        lock.Dispose()\n\n    out = [u\"Osovina: {0}, grupa: {1}, profila: {2}, razmera: 1:{3}\".format(\n        aln_name, slg_name, len(sections), S)]\n    for i, m in enumerate(mats):\n        out.append(u\"Ukupno {0}: {1} m³\".format(m, fmt(totals[i])))\n    out.append(u\"Napravljeno lejauta: {0}\".format(len(names)))\n    return out + names + log\n\n\ndef _box_ok(b):\n    if b is None:\n        return False\n    for v in b:\n        if v != v or abs(v) > 1e12:   # NaN ili \"prazne\" granice (1e20)\n            return False\n    return (b[2] - b[0]) > 0.5 and (b[3] - b[1]) > 0.5\n\n\ndef _ext_box(e):\n    return (e.MinPoint.X, e.MinPoint.Y, e.MaxPoint.X, e.MaxPoint.Y)\n\n\ndef _explode_box(sv):\n    \"\"\"Stvarne granice svega što prikaz crta (mreža, kote, trake, oznake): eksplodira se u memoriji,\n    crtež se ne menja.\"\"\"\n    from Autodesk.AutoCAD.DatabaseServices import DBObjectCollection\n    coll = DBObjectCollection()\n    sv.Explode(coll)\n    b = None\n    try:\n        for o in coll:\n            try:\n                e = o.GeometricExtents\n            except Exception:\n                continue\n            eb = _ext_box(e)\n            if not _box_ok((eb[0], eb[1], eb[0] + 1, eb[1] + 1)) or not _box_ok((eb[2], eb[3], eb[2] + 1, eb[3] + 1)):\n                continue\n            b = eb if b is None else (min(b[0], eb[0]), min(b[1], eb[1]), max(b[2], eb[2]), max(b[3], eb[3]))\n    finally:\n        for o in coll:\n            try:\n                o.Dispose()\n            except Exception:\n                pass\n    return b\n\n\ndef view_extents(sv):\n    \"\"\"Granice prikaza preseka u modelu: Explode (sve) -> GeometricExtents (+ margine) -> Bounds -> ofset/kota.\n    Vraća (box, izvor, lista grešaka).\"\"\"\n    errs = []\n    try:\n        b = _explode_box(sv)\n        if _box_ok(b):\n            m = CFG[\"MARGINA_PRIKAZA\"]\n            return (b[0] - m, b[1] - m, b[2] + m, b[3] + m), u\"Explode\", errs\n        errs.append(u\"Explode neispravan: {0}\".format(b))\n    except Exception as e:\n        errs.append(u\"Explode: {0}\".format(e))\n    try:\n        b = _ext_box(sv.GeometricExtents)\n        if _box_ok(b):\n            return b, u\"GeometricExtents\", errs\n        errs.append(u\"GeometricExtents neispravan: {0}\".format(b))\n    except Exception as e:\n        errs.append(u\"GeometricExtents: {0}\".format(e))\n    try:\n        e = sv.Bounds\n        if e is not None:\n            e = getattr(e, \"Value\", e)\n            b = _ext_box(e)\n            if _box_ok(b):\n                return b, u\"Bounds\", errs\n            errs.append(u\"Bounds neispravan: {0}\".format(b))\n        else:\n            errs.append(u\"Bounds = None\")\n    except Exception as e:\n        errs.append(u\"Bounds: {0}\".format(e))\n    try:\n        def xy(off, el):\n            r = sv.FindXYAtOffsetAndElevation(off, el, 0.0, 0.0)\n            nums = [v for v in (r if isinstance(r, tuple) else (r,)) if isinstance(v, float)]\n            return nums[-2], nums[-1]\n        x0, y0 = xy(sv.OffsetMin, sv.ElevationMin)\n        x1, y1 = xy(sv.OffsetMax, sv.ElevationMax)\n        h = abs(y1 - y0)\n        b = (min(x0, x1), min(y0, y1) - 0.6 * h, max(x0, x1), max(y0, y1) + 0.05 * h)  # + rezerva za trake\n        if _box_ok(b):\n            return b, u\"ofset/kota (procena traka)\", errs\n        errs.append(u\"ofset/kota neispravno: {0}\".format(b))\n    except Exception as e:\n        errs.append(u\"ofset/kota: {0}\".format(e))\n    return None, None, errs\n\n\nclass CivilCanvas(object):\n    ATT = {\"TL\": \"TopLeft\", \"TC\": \"TopCenter\", \"TR\": \"TopRight\", \"ML\": \"MiddleLeft\",\n           \"MC\": \"MiddleCenter\", \"MR\": \"MiddleRight\", \"BL\": \"BottomLeft\"}\n    LAYERS = {\"DOK-OKVIR\": (7, True), \"DOK-TABELA\": (8, True), \"DOK-TEKST\": (7, True),\n              \"DOK-VIEWPORT\": (4, False)}\n\n    def __init__(self, db, tr, lm, locals_, log):\n        self.db, self.tr, self.lm, self.k, self.log = db, tr, lm, locals_, log\n        self.btr = None\n        k = self.k\n        lt = tr.GetObject(db.LayerTableId, k[\"OpenMode\"].ForWrite)\n        for name, (aci, plot) in self.LAYERS.items():\n            if not lt.Has(name):\n                r = k[\"LayerTableRecord\"]()\n                r.Name = name\n                r.Color = k[\"Color\"].FromColorIndex(k[\"ColorMethod\"].ByAci, aci)\n                r.IsPlottable = plot\n                lt.Add(r)\n                tr.AddNewlyCreatedDBObject(r, True)\n        tst = tr.GetObject(db.TextStyleTableId, k[\"OpenMode\"].ForWrite)\n        if not tst.Has(\"DOK-Arial\"):\n            r = k[\"TextStyleTableRecord\"]()\n            r.Name = \"DOK-Arial\"\n            r.Font = k[\"FontDescriptor\"](\"Arial\", False, False, 0, 0)\n            tst.Add(r)\n            tr.AddNewlyCreatedDBObject(r, True)\n        self.style_id = tst.get_Item(\"DOK-Arial\")\n\n    def begin_sheet(self, name):\n        k, tr = self.k, self.tr\n        lid = self.lm.CreateLayout(name)\n        lay = tr.GetObject(lid, k[\"OpenMode\"].ForWrite)\n        try:\n            psv = k[\"PlotSettingsValidator\"].Current\n            ps = k[\"PlotSettings\"](False)\n            ps.CopyFrom(lay)\n            psv.SetPlotConfigurationName(ps, CFG[\"UREDJAJ\"], None)\n            psv.RefreshLists(ps)\n            psv.SetCanonicalMediaName(ps, CFG[\"FORMAT_PAPIRA\"])\n            psv.SetPlotPaperUnits(ps, k[\"PlotPaperUnit\"].Millimeters)\n            psv.SetPlotType(ps, k[\"PlotType\"].Layout)\n            psv.SetUseStandardScale(ps, True)\n            psv.SetStdScaleType(ps, k[\"StdScaleType\"].StdScale1To1)\n            psv.SetPlotRotation(ps, k[\"PlotRotation\"].Degrees000)\n            lay.CopyFrom(ps)\n        except Exception as e:\n            self.log.append(u\"Upozorenje: podešavanje štampe za '{0}': {1}\".format(name, e))\n        self.lm.CurrentLayout = name\n        self.btr = tr.GetObject(lay.BlockTableRecordId, k[\"OpenMode\"].ForWrite)\n\n    def _add(self, ent, layer, color=None):\n        ent.SetDatabaseDefaults(self.db)\n        ent.Layer = layer\n        if color is not None:\n            ent.ColorIndex = color\n        self.btr.AppendEntity(ent)\n        self.tr.AddNewlyCreatedDBObject(ent, True)\n        return ent\n\n    def line(self, x1, y1, x2, y2, layer):\n        P = self.k[\"Point3d\"]\n        self._add(self.k[\"Line\"](P(x1, y1, 0), P(x2, y2, 0)), layer)\n\n    def rect(self, x0, y0, x1, y1, layer):\n        P2 = self.k[\"Point2d\"]\n        pl = self.k[\"Polyline\"]()\n        for i, (x, y) in enumerate([(x0, y0), (x1, y0), (x1, y1), (x0, y1)]):\n            pl.AddVertexAt(i, P2(x, y), 0, 0, 0)\n        pl.Closed = True\n        self._add(pl, layer)\n\n    def text(self, x, y, s, h, attach=\"TL\", width=0, layer=\"DOK-TEKST\", color=None):\n        mt = self.k[\"MText\"]()\n        mt.SetDatabaseDefaults(self.db)\n        mt.Location = self.k[\"Point3d\"](x, y, 0)\n        mt.TextStyleId = self.style_id\n        mt.TextHeight = h\n        mt.Attachment = getattr(self.k[\"AttachmentPoint\"], self.ATT[attach])\n        if width:\n            mt.Width = width\n        s = s.replace(u\"\\\\\", u\"\\\\\\\\\").replace(u\"{\", u\"\\\\{\").replace(u\"}\", u\"\\\\}\")\n        mt.Contents = s.replace(u\"\\n\", u\"\\\\P\")\n        self._add(mt, layer, color)\n\n    def viewport(self, box, sec):\n        k = self.k\n        if not _box_ok(box):\n            raise ValueError(u\"Neispravna veličina viewporta za profil {0}: {1}\".format(sec[\"name\"], box))\n        vp = k[\"Viewport\"]()\n        vp.SetDatabaseDefaults(self.db)\n        vp.CenterPoint = k[\"Point3d\"]((box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0, 0)\n        vp.Width = box[2] - box[0]\n        vp.Height = box[3] - box[1]\n        vp.Layer = \"DOK-VIEWPORT\"\n        self.btr.AppendEntity(vp)\n        self.tr.AddNewlyCreatedDBObject(vp, True)\n        vp.ViewDirection = k[\"Vector3d\"].ZAxis\n        vp.ViewTarget = k[\"Point3d\"](sec[\"cx\"], sec[\"cy\"], 0)\n        vp.ViewCenter = k[\"Point2d\"](0, 0)\n        vp.CustomScale = 1000.0 / sec[\"scale\"]\n        vp.On = True\n        vp.Locked = True\n\n    def insert_block(self, name):\n        k, tr = self.k, self.tr\n        bt = tr.GetObject(self.db.BlockTableId, k[\"OpenMode\"].ForRead)\n        if not bt.Has(name):\n            self.log.append(u\"Upozorenje: blok '{0}' ne postoji – crta se jednostavan okvir.\".format(name))\n            return False\n        br = k[\"BlockReference\"](k[\"Point3d\"](0, 0, 0), bt.get_Item(name))\n        self._add(br, \"DOK-OKVIR\")\n        return True\n\n\n# =====================================================================\n# ULAZ / IZLAZ ZA DYNAMO\n# =====================================================================\nif \"__DOK_TEST__\" not in globals():\n    import traceback\n    try:\n        _in = IN  # noqa: F821  (Dynamo ulaz)\n    except NameError:\n        _in = [u\"\"]\n    try:\n        OUT = run_civil(_in)\n    except Exception:\n        OUT = [u\"GREŠKA:\", traceback.format_exc()]\n",
